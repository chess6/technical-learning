{
  "name": "linear-algebra-visual-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "animate": "node scripts/animate-scene.mjs",
    "animation:review": "node scripts/review-animation.mjs",
    "animation:iterate": "node scripts/iterate-animation.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "test:grading": "vitest run src/lessons src/math src/components/assessment",
    "test:content": "vitest run src/lessons/__tests__/contentValidation.test.ts",
    "check:quick": "oxlint && tsc -b && npm run test:grading",
    "export:list": "node scripts/export-scene.mjs --list",
    "export:scene": "node scripts/export-scene.mjs"
  },
  "dependencies": {
    "@motion-canvas/2d": "^3.17.2",
    "@motion-canvas/core": "^3.17.2",
    "@motion-canvas/player": "^3.17.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "katex": "^0.18.1",
    "mafs": "^0.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.13.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "jsdom": "^29.1.1",
    "mathjs": "^15.2.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
